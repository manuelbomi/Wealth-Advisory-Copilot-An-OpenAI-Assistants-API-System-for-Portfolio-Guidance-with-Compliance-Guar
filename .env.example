# Copy this file to .env and fill in real values for LIVE mode.
#
# Leaving OPENAI_API_KEY unset (or blank) is fully supported and is how this repo
# is meant to be evaluated by default: the app automatically falls back to
# MockAssistantsClient, which deterministically simulates the OpenAI Assistants
# API thread/run/tool-call lifecycle -- no paid API key required.

# --- OpenAI Assistants API (optional -- omit to run fully offline) -----------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_NAME=Northbridge Wealth Advisory Copilot
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=4

# --- Circuit breaker ---------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# --- App metadata --------------------------------------------------------------------
APP_NAME=wealth-advisory-copilot
ENVIRONMENT=local

# --- Server ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
